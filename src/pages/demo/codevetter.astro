---
import Base from "@/layouts/Base.astro";
import Page from "@/demos/codevetter";
---

<Base
  title="CodeVetter — Execution-backed verification for coding agents"
  description="Bind the requested task to the exact change, run repository-owned checks, and keep a pass, fail, or unverified verdict with its evidence."
  theme="ink"
  icon="/demo/codevetter/icon.svg"
  tokens={{
    "--brand": "oklch(0.8 0.14 72)",
    "--brand-foreground": "oklch(0.16 0.02 70)",
    "--brand-soft": "oklch(0.8 0.14 72 / 0.14)",
    "--background": "oklch(0.115 0.004 70)",
    "--surface": "oklch(0.145 0.005 70)",
    "--card": "oklch(0.16 0.005 70)",
    "--popover": "oklch(0.18 0.005 70)",
    "--muted": "oklch(0.19 0.006 70)",
    "--secondary": "oklch(0.21 0.006 70)",
    "--accent": "oklch(0.22 0.006 70)",
    "--muted-foreground": "oklch(0.7 0.012 75)",
    "--chart-2": "oklch(0.72 0.12 40)",
  }}
>
  <Page />
</Base>
