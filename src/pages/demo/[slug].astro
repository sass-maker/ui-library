---
/**
 * Every content-driven product page. Add src/content/<slug>.json with a
 * "template" ("gallery" or "workbench") and "page" settings; no code needed.
 */
import Base from "@/layouts/Base.astro";
import { GalleryPage, type GalleryContent } from "@/templates/gallery-page";
import { WorkbenchPage, type WorkbenchContent } from "@/templates/workbench-page";
import type { PageSettings } from "@/templates/page-settings";

export function getStaticPaths() {
  const files = import.meta.glob<{ default: { template: string; page: PageSettings } }>("../../content/*.json", { eager: true });
  return Object.entries(files).map(([path, mod]) => ({
    params: { slug: path.split("/").pop()!.replace(/\.json$/, "") },
    props: { content: mod.default },
  }));
}

const { content } = Astro.props;
const { page } = content;
---

<Base title={page.title} description={page.description} theme={page.theme} mode={page.mode} tokens={page.tokens} icon={page.icon}>
  {content.template === "gallery" && <GalleryPage content={content as unknown as GalleryContent} />}
  {content.template === "workbench" && <WorkbenchPage content={content as unknown as WorkbenchContent} />}
</Base>
