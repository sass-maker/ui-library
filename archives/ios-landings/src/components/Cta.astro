---
import { appStoreBadge, primaryCta } from "../lib/distribution";

const { event } = Astro.props as { event?: string };
const cta = primaryCta();
---
{cta.kind === "app-store" ? (
  <a class="store-badge" data-cta={event} href={cta.href}>
    <img src={appStoreBadge.src} width="160" height="54" alt={appStoreBadge.alt} />
  </a>
) : (
  <a class="button" data-cta={event} href={cta.href}>
    {cta.label} <span aria-hidden="true">{cta.kind === "testflight" || cta.href.startsWith("https://") ? "↗" : "→"}</span>
  </a>
)}
