---
// Home page rendered from the product's SaaS Maker UI-library content file.
// Head tags (canonical, Open Graph, JSON-LD, Clarity, App Health) come from the
// factory's SiteHead so they match every other route; the template supplies
// layout, the StudioFooter and its sign-up, feedback and Ask AI.
import Base from "@saas-maker/templates/Base.astro";
import { baseProps } from "@saas-maker/templates/page";
import SiteHead from "./SiteHead.astro";
import { defaultTitle } from "../lib/page-title";
import { loadTemplateContent } from "../lib/template-content";

const content = await loadTemplateContent();
// Each page imports its own Tailwind entry; load only the selected family.
// Vite must eliminate the unused import before collecting CSS for this build.
const workbench = import.meta.env.PRODUCT === "storagedaddy" || import.meta.env.PRODUCT === "browserdaddy" || import.meta.env.PRODUCT === "performancedaddy";
const GalleryPage = !workbench
  ? (await import("@saas-maker/templates/gallery-page")).GalleryPage : undefined;
const WorkbenchPage = workbench
  ? (await import("@saas-maker/templates/workbench-page")).WorkbenchPage : undefined;
const { theme, mode, tokens, motion, fonts, surface, fromApp } = baseProps(content);
// The PerformanceDaddy lede is the mobile LCP; start its existing body face
// with the display face instead of waiting for CSS font discovery.
const bodyFont = import.meta.env.PRODUCT === "performancedaddy"
  ? (await import("@saas-maker/ui/fonts/geist-latin-normal.woff2?url")).default : undefined;
---
<Base title={defaultTitle()} theme={theme} mode={mode} fonts={fonts} surface={surface} fromApp={fromApp} tokens={tokens} motion={motion}>
  <Fragment slot="head">
    <SiteHead studioFooter />
    {bodyFont && <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />}
  </Fragment>
  {content.template === "gallery" && GalleryPage && <GalleryPage content={content} />}
  {content.template === "workbench" && WorkbenchPage && <WorkbenchPage content={content} />}
</Base>
