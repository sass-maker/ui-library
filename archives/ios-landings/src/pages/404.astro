---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../site.config";
---
<SiteLayout
  title={`Page not found — ${site.name}`}
  description={`This address does not identify a public ${site.name} page. Return to the product overview or use the verified support links.`}
  canonicalPath="/"
  markdownAlternatePath="/404.md"
  robots="noindex,follow"
  includeStructuredData={false}
>
  <div class="legal-main shell">
    <p class="eyebrow">404</p>
    <h1>This page is not part of {site.name}.</h1>
    <p class="legal-lede prose">
      The address may be old or incomplete. The product overview records the current purpose,
      access, privacy, and support boundaries.
    </p>
    <p style="margin-top: 28px"><a class="button" href="/">Return to {site.name}</a></p>
  </div>
</SiteLayout>
