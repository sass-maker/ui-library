---
import { render, type CollectionEntry } from "astro:content";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { blogPath, getPublishedPosts } from "../../../lib/blog";
import { productId, site } from "../../../site.config";
import { screenshotMetadata } from "../../../lib/screenshot-metadata.mjs";
import "../../../styles/blog.css";
export async function getStaticPaths() {
  return (await getPublishedPosts()).map(post => ({ params: { slug: post.id.split("/")[1] }, props: { post } }));
}
interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const cover = post.data.cover;
const dimensions = cover ? await screenshotMetadata(productId, cover.src) : null;
const readingMinutes = Math.max(1, Math.ceil((post.body ?? "").split(/\s+/).length / 220));
const seoTitle = post.data.seoTitle ?? `${post.data.title} — ${site.name}`;
const seoDescription = post.data.seoDescription ?? post.data.description;
const schema = { "@context": "https://schema.org", "@type": "BlogPosting", headline: post.data.title, description: post.data.description, datePublished: post.data.published, dateModified: post.data.updated ?? post.data.published, author: { "@type": "Organization", name: post.data.author }, publisher: { "@type": "Organization", name: "Significant Hobbies" }, mainEntityOfPage: new URL(blogPath(post), site.url).href, ...(cover ? { image: new URL(cover.src, site.url).href } : {}) };
---
<SiteLayout title={seoTitle} description={seoDescription} canonicalPath={blogPath(post)} image={cover?.src} includeStructuredData={false}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
  <article class="shell blog-article">
    <a class="blog-back" href="/blog/">← {site.name} journal</a>
    <header class="article-heading"><p class="blog-kicker">{post.data.tags.join(" / ")}</p><h1>{post.data.title}</h1><p class="blog-intro">{post.data.description}</p><p class="blog-meta">{post.data.author} · <time datetime={post.data.published}>{post.data.published}</time> · {readingMinutes} min read{post.data.updated && <> · Updated <time datetime={post.data.updated}>{post.data.updated}</time></>}</p></header>
    {cover && dimensions && <figure class="article-cover"><img src={cover.src} alt={cover.alt} width={dimensions.width} height={dimensions.height} /><figcaption>{cover.alt}</figcaption></figure>}
    <div class="article-grid">
      {headings.length > 1 && <nav class="article-toc" aria-label="On this page"><p>In this note</p>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>}
      <div class="article-copy"><Content /><footer class="article-end"><a href="/">Explore {site.name} →</a><a href="/blog/">All notes →</a></footer></div>
    </div>
  </article>
</SiteLayout>
