---
import LegalPage from "../components/LegalPage.astro";
import { site } from "../site.config";
const page = site.legal.support;
---
<LegalPage title={page.title} lede={page.lede} path="/support/">
  {page.sections.map((section) => (
    <section>
      <h2>{section.title}</h2>
      <p>{section.body}</p>
      {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
      {section.links && <ul>
        {section.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>}
    </section>
  ))}
</LegalPage>
