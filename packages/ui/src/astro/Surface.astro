---
import { cardStyles } from "../lib/native-primitives";
interface Props extends Record<string, unknown> {
  as?: "div" | "section" | "aside" | "article" | "label";
  class?: string;
}
const { as: Tag = "div", class: className, ...attributes } = Astro.props;
---
<Tag {...attributes} data-slot="card" class={cardStyles(className)}><slot /></Tag>
