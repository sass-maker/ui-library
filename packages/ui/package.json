{
  "name": "@saas-maker/ui",
  "version": "0.1.26",
  "private": true,
  "type": "module",
  "description": "SaaS Maker UI: shadcn/ui components, theme presets and page blocks shared across Fleet products.",
  "sideEffects": [
    "*.css",
    "./footer.js"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./blocks/*": "./src/blocks/*.tsx",
    "./utils": "./src/lib/utils.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles/globals.css",
    "./theme.css": "./src/styles/theme.css",
    "./source-gallery.css": "./src/styles/source-gallery.css",
    "./source-shell.css": "./src/styles/source-shell.css",
    "./source-workbench.css": "./src/styles/source-workbench.css",
    "./source-console.css": "./src/styles/source-console.css",
    "./fonts/*": "./src/fonts/*",
    "./footer.js": "./footer.js",
    "./footer.css": "./footer.css",
    "./footer-html": {
      "types": "./footer-html.d.ts",
      "default": "./footer-html.js"
    },
    "./recipes/*": "./src/recipes/*.tsx",
    "./effects/*": "./src/effects/*.tsx",
    "./molecules/*": "./src/molecules/*.tsx",
    "./organisms/*": "./src/organisms/*.tsx",
    "./molecules/calendar": "./src/components/calendar.tsx",
    "./molecules/combobox": "./src/components/combobox.tsx",
    "./molecules/command": "./src/components/command.tsx",
    "./molecules/context-menu": "./src/components/context-menu.tsx",
    "./molecules/dropdown-menu": "./src/components/dropdown-menu.tsx",
    "./molecules/menubar": "./src/components/menubar.tsx",
    "./molecules/navigation-menu": "./src/components/navigation-menu.tsx",
    "./molecules/pagination": "./src/components/pagination.tsx",
    "./molecules/breadcrumb": "./src/components/breadcrumb.tsx",
    "./molecules/input-otp": "./src/components/input-otp.tsx",
    "./molecules/input-group": "./src/components/input-group.tsx",
    "./molecules/resizable": "./src/components/resizable.tsx",
    "./molecules/scroll-area": "./src/components/scroll-area.tsx",
    "./molecules/toggle-group": "./src/components/toggle-group.tsx",
    "./molecules/tabs": "./src/components/tabs.tsx",
    "./molecules/accordion": "./src/components/accordion.tsx",
    "./molecules/collapsible": "./src/components/collapsible.tsx",
    "./molecules/dialog": "./src/components/dialog.tsx",
    "./molecules/alert-dialog": "./src/components/alert-dialog.tsx",
    "./molecules/drawer": "./src/components/drawer.tsx",
    "./molecules/sheet": "./src/components/sheet.tsx",
    "./molecules/popover": "./src/components/popover.tsx",
    "./molecules/hover-card": "./src/components/hover-card.tsx",
    "./molecules/sonner": "./src/components/sonner.tsx",
    "./molecules/alert": "./src/components/alert.tsx",
    "./molecules/empty-state": "./src/components/empty-state.tsx",
    "./molecules/error-state": "./src/components/error-state.tsx",
    "./organisms/data-table": "./src/components/data-table.tsx",
    "./organisms/kanban-board": "./src/recipes/kanban-board.tsx",
    "./organisms/multi-step-form": "./src/recipes/multi-step-form.tsx",
    "./atoms/card": "./src/components/card.tsx",
    "./atoms/slider": "./src/components/slider.tsx",
    "./atoms/progress": "./src/components/progress.tsx",
    "./atoms/label": "./src/components/label.tsx",
    "./atoms/tooltip": "./src/components/tooltip.tsx",
    "./atoms/switch": "./src/components/switch.tsx",
    "./atoms/radio-group": "./src/components/radio-group.tsx",
    "./atoms/avatar": "./src/components/avatar.tsx",
    "./atoms/kbd": "./src/components/kbd.tsx",
    "./atoms/badge": "./src/components/badge.tsx",
    "./atoms/table": "./src/components/table.tsx",
    "./atoms/separator": "./src/components/separator.tsx",
    "./atoms/button": "./src/components/button.tsx",
    "./atoms/toggle": "./src/components/toggle.tsx",
    "./atoms/checkbox": "./src/components/checkbox.tsx",
    "./atoms/select": "./src/components/select.tsx",
    "./atoms/textarea": "./src/components/textarea.tsx",
    "./atoms/input": "./src/components/input.tsx",
    "./atoms/skeleton": "./src/components/skeleton.tsx",
    "./visual-sources.json": "./visual-sources.json",
    "./atoms/responsive-image": "./src/components/responsive-image.tsx",
    "./atoms/video": "./src/components/video.tsx"
  },
  "dependencies": {
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "motion": "13.4.3",
    "input-otp": "1.5.0",
    "react-day-picker": "10.0.2",
    "react-resizable-panels": "4.14.8",
    "vaul": "1.1.2",
    "react-use-measure": "2.1.7",
    "cobe": "2.0.1",
    "@base-ui/react": "1.9.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4.3"
  },
  "scripts": {
    "fonts:build": "uv run --with fonttools --with brotli scripts/build-fonts.sh",
    "footer:build": "node scripts/build-footer.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "vitest": "3.2.7",
    "happy-dom": "20.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tailwindcss/node": "4.3.3"
  }
}
