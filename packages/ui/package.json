{
  "name": "@saas-maker/ui",
  "version": "0.1.18",
  "private": true,
  "type": "module",
  "description": "SaaS Maker UI: shadcn/ui components, theme presets and page blocks shared across Fleet products.",
  "sideEffects": [
    "*.css",
    "./footer.js"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./blocks/*": "./src/blocks/*.tsx",
    "./utils": "./src/lib/utils.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles/globals.css",
    "./theme.css": "./src/styles/theme.css",
    "./source-gallery.css": "./src/styles/source-gallery.css",
    "./source-shell.css": "./src/styles/source-shell.css",
    "./source-workbench.css": "./src/styles/source-workbench.css",
    "./source-console.css": "./src/styles/source-console.css",
    "./fonts/*": "./src/fonts/*",
    "./footer.js": "./footer.js",
    "./footer.css": "./footer.css",
    "./footer-html": {
      "types": "./footer-html.d.ts",
      "default": "./footer-html.js"
    }
  },
  "dependencies": {
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4.3"
  },
  "scripts": {
    "fonts:build": "uv run --with fonttools --with brotli scripts/build-fonts.sh",
    "footer:build": "node scripts/build-footer.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "vitest": "3.2.7",
    "happy-dom": "20.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tailwindcss/node": "4.3.3"
  }
}
