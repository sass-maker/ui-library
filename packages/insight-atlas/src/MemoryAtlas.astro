          <div class="workbench">
            <section id="topic-map" class="map-panel" aria-labelledby="topic-heading">
              <div class="section-heading">
                <div>
                  <p class="map-key">Things connected by meaning</p>
                  <h2 id="topic-heading" class="font-display">Topic map</h2>
                </div>
                <p>Node size is conversation count. Lines are semantic proximity.</p>
              </div>
              <form id="memory-search" class="memory-search" role="search">
                <label for="search-query">Search your mapped memory</label>
                <div class="search-field">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="6.5"></circle>
                    <path d="m15.5 15.5 5 5"></path>
                  </svg>
                  <Control as="input"
                    id="search-query"
                    name="query"
                    type="search"
                    autocomplete="off"
                    placeholder="Search what you asked, changed, or returned to" />
                  <Control as="button" variant="brand" type="submit">Search</Control>
                </div>
                <div id="search-results" class="search-results" hidden></div>
              </form>
              <div id="graph-loading" class="graph-loading">
                <span></span>
                <strong>Semantic map is still forming.</strong>
                <small>Deterministic insights are ready below.</small>
              </div>
              <svg
                id="topic-graph"
                class="topic-graph is-hidden"
                viewBox="0 0 1000 620"
                role="group"
                aria-label="Interactive semantic topic graph"
              ></svg>
              <p class="mobile-graph-note">Every route is shown · the complete topic list follows.</p>
              <div id="topic-list" class="topic-list" aria-label="Accessible topic list"></div>
            </section>

            <div class="memory-sidecar">
              <section
                id="memory-chat"
                class="memory-chat-panel"
                aria-labelledby="memory-chat-heading"
              >
                <header>
                  <div>
                    <p class="map-key">Ask the graph</p>
                    <h2 id="memory-chat-heading" class="font-display">Memory Chat</h2>
                  </div>
                  <Control as="button" variant="outline" selection="primary" id="unload-memory-chat" type="button" hidden>Unload model</Control>
                </header>
                <p class="memory-chat-promise">
                  Your question traverses the map first. A small local model sees only the six
                  retrieved evidence stops—not the full ZIP.
                </p>

                <div id="memory-chat-gate" class="memory-chat-gate">
                  <dl>
                    <div><dt>Model</dt><dd>LaMini-Flan-T5 77M</dd></div>
                    <div><dt>Download</dt><dd>≈105 MB · cached by your browser</dd></div>
                    <div><dt>Boundary</dt><dd>Local q8 synthesis · English-focused</dd></div>
                  </dl>
                  <Control as="button" variant="brand" id="enable-memory-chat" class="" type="button" disabled>
                    Available when the map is complete
                  </Control>
                  <p id="memory-chat-model-status" role="status" aria-live="polite">
                    The chat model has not been loaded.
                  </p>
                  <Control as="progress" id="memory-chat-model-progress" max="100" value="0" hidden></Control>
                </div>

                <div id="memory-chat-session" class="memory-chat-session" hidden>
                  <div
                    id="memory-chat-transcript"
                    class="memory-chat-transcript"
                    role="log"
                    aria-live="polite"
                    aria-label="Memory chat conversation"
                  >
                    <article class="memory-chat-message assistant">
                      <span>Local guide</span>
                      <p>Ask what you returned to, changed, rejected, or worked on over time.</p>
                    </article>
                  </div>

                  <section class="traversal-ledger" aria-labelledby="traversal-heading">
                    <div>
                      <p class="map-key">Visible retrieval route</p>
                      <h3 id="traversal-heading">How the graph answered</h3>
                    </div>
                    <ol id="memory-chat-route">
                      <li data-chat-stage="query"><i></i><span>Question received</span></li>
                      <li data-chat-stage="search"><i></i><span>Searching semantic memory</span></li>
                      <li data-chat-stage="topics"><i></i><span>Traversing topic routes</span></li>
                      <li data-chat-stage="evidence"><i></i><span>Building evidence pack</span></li>
                      <li data-chat-stage="answer"><i></i><span>Local synthesis</span></li>
                    </ol>
                    <div id="memory-chat-evidence" class="memory-chat-evidence"></div>
                  </section>

                  <form id="memory-chat-form">
                    <label for="memory-chat-query">Ask your mapped memory</label>
                    <Control as="textarea"
                      id="memory-chat-query"
                      name="memory-question"
                      rows="3"
                      maxlength="600"
                      placeholder="What have I changed my mind about?"
                      required
                    ></Control>
                    <Control as="button" variant="brand" class="" type="submit">Traverse and answer</Control>
                  </form>
                </div>

                <Control as="details" class="memory-architecture-note">
                  <Control as="summary">Why this memory architecture is different</Control>
                  <p>
                    The retrieval route, sources, changed and refuted statements, confidence
                    controls, and local model boundary stay visible. Generated prose never becomes
                    a new memory automatically.
                  </p>
                  <p>
                    This is a product-behavior prototype, not a claim about current ChatGPT
                    internals. OpenAI’s own documentation says its legacy saved-memory experience
                    could become stale or contradictory.
                  </p>
                  <a
                    href="https://help.openai.com/en/articles/8590148-memory-faq"
                    target="_blank"
                    rel="noreferrer"
                  >Read OpenAI’s Memory FAQ ↗</a>
                </Control>
              </section>

              <aside id="memory-ledger" class="ledger-panel" aria-labelledby="ledger-heading">
                <div class="section-heading compact">
                  <div>
                    <p class="map-key">Statement history</p>
                    <h2 id="ledger-heading" class="font-display">Memory ledger</h2>
                  </div>
                </div>
                <div id="ledger-tabs" class="ledger-tabs" role="tablist" aria-label="Fact states">
                  <Control as="button" variant="outline" selection="primary" type="button" role="tab" data-status="current" aria-selected="true">
                    Current <span>0</span>
                  </Control>
                  <Control as="button" variant="outline" selection="primary" type="button" role="tab" data-status="updated" aria-selected="false">
                    Updated <span>0</span>
                  </Control>
                  <Control as="button" variant="outline" selection="primary" type="button" role="tab" data-status="refuted" aria-selected="false">
                    Refuted <span>0</span>
                  </Control>
                  <Control as="button" variant="outline" selection="primary" type="button" role="tab" data-status="contradicted" aria-selected="false">
                    Possible contradictions <span>0</span>
                  </Control>
                </div>
                <div id="ledger-list" class="ledger-list">
                  <p class="empty-note">Fact candidates appear after semantic grouping.</p>
                </div>
                <p class="ledger-disclaimer">
                  Detected from explicit first-person wording. These are candidates, not verified
                  truths.
                </p>
              </aside>
            </div>
