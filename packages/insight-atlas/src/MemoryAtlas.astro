---
import Control from "@saas-maker/ui/astro/Control.astro";
import ChartPanel from "@saas-maker/ui/astro/ChartPanel.astro";
import Surface from "@saas-maker/ui/astro/Surface.astro";
import { chartHeaderStyles, chartTitleStyles, chartDescriptionStyles } from "@saas-maker/ui/lib/chart-styles";
interface Props {
  indexCopy: { text: string }[];
  chatgptExportSteps: { text: string; strong?: boolean }[][];
  privacyContract: string;
  demoEnabled?: boolean;
}
const { indexCopy, chatgptExportSteps, privacyContract, demoEnabled = false } = Astro.props;
---

    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="app-shell">
      <aside class="route-rail" aria-label="Report sections">
        <a class="brand" href="#main" aria-label="Memory Map home">
          <svg viewBox="0 0 36 36" aria-hidden="true">
            <path d="M7 8 17 15 29 7M17 15l1 14M7 27l11 2 11-9" />
            <circle cx="7" cy="8" r="3" />
            <circle cx="29" cy="7" r="3" />
            <circle cx="17" cy="15" r="3" />
            <circle cx="7" cy="27" r="3" />
            <circle cx="18" cy="29" r="3" />
            <circle cx="29" cy="20" r="3" />
          </svg>
          <span>Memory Map</span>
        </a>
        <p class="brand-note">Detected from your own statements.</p>

        <nav id="report-nav" hidden>
          <p class="map-key">Routes</p>
          <a href="#visual-atlas"><i class="route-dot route-red"></i>Visual atlas</a>
          <a href="#topic-map"><i class="route-dot route-blue"></i>Topic map</a>
          <a href="#memory-chat"><i class="route-dot route-red"></i>Memory chat</a>
          <a href="#memory-ledger"><i class="route-dot route-teal"></i>Memory ledger</a>
          <a href="#evolution"><i class="route-dot route-violet"></i>How it changed</a>
          <a href="#question-lenses"><i class="route-dot route-amber"></i>Question lenses</a>
          <a href="#repeated-questions"><i class="route-dot route-red"></i>Repeated questions</a>
          <a href="#reflection-questions"><i class="route-dot route-violet"></i>Questions for you</a>
          <a href="#query-tone"><i class="route-dot route-amber"></i>Query tone</a>
          <a href="#rhythms"><i class="route-dot route-violet"></i>Rhythms</a>
          <a id="efficiency-route" href="#efficiency" hidden
            ><i class="route-dot route-teal"></i>Efficiency</a
          >
        </nav>

      <div class="rail-footer">
        <a href="/about/">What Memory Map does</a>
        <a href="/changelog/">Changelog</a>
          <span class="rail-privacy">
            <span class="privacy-mark" aria-hidden="true">◇</span>
            <span>Archive contents stay on this device</span>
          </span>
        </div>
      </aside>

      <main id="main">
        <section id="import-view" class="import-view" aria-labelledby="import-heading">
          <div class="import-copy">
            <p class="map-key">{indexCopy[0].text}</p>
            <h1 id="import-heading" class="font-display">{indexCopy[1].text}</h1>
            <p class="lede">{indexCopy[2].text}</p>
            <a class="product-tour-link" href="/about/" data-app-health-event="capabilities_opened"
              >See all 51 things Memory Map can find →</a
            >
          </div>

          {demoEnabled && (
            <Surface class="demo-entry grid gap-5 p-6 sm:grid-cols-[1fr_auto]">
              <div><span class="map-key">Take the atlas for a spin</span><strong>A real history. Only the patterns.</strong><p>Explore activity and topic connections from a real archive, with every conversation kept private.</p></div>
              <Control as="button" variant="brand" id="load-demo" class="" type="button">Explore the demo <span aria-hidden="true">↗</span></Control>
              <small>Downloads only when you ask. No chat text, titles, names or links.</small>
            </Surface>
          )}

          <Control as="details" class="export-guide">
            <Control as="summary">
              <span>Need the ZIP?</span>
              <strong>{indexCopy[3].text}</strong>
            </Control>
            <div class="export-guide-body">
              <ol>
                {chatgptExportSteps.map((parts) => (
                  <li>{parts.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</li>
                ))}
                <li>{indexCopy[8].text}</li>
              </ol>
              <div class="export-guide-notes">
                <p>{indexCopy[9].text}</p>
                <p>{indexCopy[10].text}</p>
              </div>
              <nav class="export-guide-links" aria-label="ChatGPT export resources">
                <a href="https://chatgpt.com/" target="_blank" rel="noreferrer">Open ChatGPT ↗</a>
                <a
                  href="https://help.openai.com/en/articles/7260999-how-do-i-export-my-chatgpt-history-and-data"
                  target="_blank"
                  rel="noreferrer">Official instructions ↗</a
                >
                <a href="https://privacy.openai.com/" target="_blank" rel="noreferrer"
                  >Privacy Portal ↗</a
                >
              </nav>
            </div>
          </Control>

          <Control as="details" class="export-guide">
            <Control as="summary">
              <span>Use Claude Code or Codex?</span>
              <strong>{indexCopy[11].text}</strong>
            </Control>
            <div class="export-guide-body">
              <ol>
                <li>
                  Install it, on macOS or Linux:<br />
                  <code>curl -fsSL https://chatgpt.significanthobbies.com/install.sh | sh</code>
                </li>
                <li>
                  See what it finds, without writing anything:<br />
                  <code>memory-pack --dry-run --list</code>
                </li>
                <li>
                  Write the archive into the current folder:<br />
                  <code>memory-pack</code>
                </li>
                <li>
                  Drop the <code>memory-pack-&lt;date&gt;.zip</code> it names here, without
                  unzipping it.
                </li>
              </ol>
              <div class="export-guide-notes">
                <p>{indexCopy[12].text}</p>
                <p>{indexCopy[13].text}</p>
                <p>
                  The installer downloads one small binary and checks it against a published
                  checksum. memory-pack itself then runs entirely on your machine, makes no
                  network calls, and masks credential-shaped tokens before it writes anything.
                  On Windows, download the <code>.exe</code> from the releases page and run it
                  directly.
                </p>
                <p>
                  Narrow it with <code>--since 2026-01-01</code>, or pack only sessions whose
                  full transcript survives with <code>--no-history</code>.
                </p>
              </div>
              <nav class="export-guide-links" aria-label="memory-pack resources">
                <a
                  href="https://github.com/sarthakagrawal927/chatgpt-memory-insights/releases"
                  target="_blank"
                  rel="noreferrer">Binaries and checksums ↗</a
                >
                <a
                  href="https://github.com/sarthakagrawal927/chatgpt-memory-insights/tree/main/packer"
                  target="_blank"
                  rel="noreferrer">How it works ↗</a
                >
              </nav>
            </div>
          </Control>

          <fieldset class="analysis-setup">
            <legend>Choose the analysis lens</legend>
            <div class="model-profile-options">
              <label>
                <Control as="input" type="radio" name="model-profile" value="auto" checked />
                <span><strong>{indexCopy[14].text}</strong><small>{indexCopy[15].text}</small></span>
              </label>
              <label>
                <Control as="input" type="radio" name="model-profile" value="compact" />
                <span><strong>{indexCopy[16].text}</strong><small>{indexCopy[17].text}</small></span>
              </label>
              <label>
                <Control as="input" type="radio" name="model-profile" value="multilingual" />
                <span><strong>{indexCopy[18].text}</strong><small>{indexCopy[19].text}</small></span>
              </label>
            </div>
            <div class="confidence-control">
              <div>
                <strong>{indexCopy[20].text}</strong>
                <small>{indexCopy[21].text}</small>
              </div>
              <div class="confidence-presets" aria-label="Evidence confidence presets">
                <Control as="button" variant="outline" selection="primary" type="button" data-confidence="45">Exploratory</Control>
                <Control as="button" variant="outline" selection="primary" type="button" data-confidence="65" aria-pressed="true">Balanced</Control>
                <Control as="button" variant="outline" selection="primary" type="button" data-confidence="82">Conservative</Control>
              </div>
              <label for="confidence-input">
                <span>Threshold</span>
                <Control as="input" id="confidence-input" type="range" min="35" max="90" value="65" />
                <output id="confidence-output" for="confidence-input">65%</output>
              </label>
            </div>
          </fieldset>

          <div class="import-grid">
            <label id="drop-zone" class="drop-zone" for="archive-input">
              <Control as="input"
                id="archive-input"
                class="sr-only h-px w-px min-w-0 p-0 [@media(pointer:coarse)]:min-h-0"
                type="file"
                accept=".zip,application/zip"
                data-app-health-event="archive_import_started" />
              <span class="file-mark" aria-hidden="true">.ZIP</span>
              <strong>{indexCopy[22].text}</strong>
              <span>or drop a ChatGPT export or memory-pack ZIP here</span>
              <small>{indexCopy[23].text}</small>
            </label>

            <ol class="route-explainer" aria-label="Analysis stages">
              <li>
                <span>1</span>
                <div><strong>{indexCopy[24].text}</strong><small>{indexCopy[25].text}</small></div>
              </li>
              <li>
                <span>2</span>
                <div><strong>{indexCopy[26].text}</strong><small>{indexCopy[27].text}</small></div>
              </li>
              <li>
                <span>3</span>
                <div><strong>{indexCopy[28].text}</strong><small>{indexCopy[29].text}</small></div>
              </li>
            </ol>
          </div>

          <div class="privacy-contract">
            <strong>{indexCopy[30].text}</strong>
            <span>{privacyContract}</span>
          </div>
        </section>

        <section id="demo-progress" class="demo-progress" aria-labelledby="demo-progress-heading" hidden>
            <div class="demo-loader-map" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
            <p class="map-key">Opening the public atlas</p>
            <h2 id="demo-progress-heading" class="font-display">Bringing the patterns into view.</h2>
            <p id="demo-progress-status" role="status" aria-live="polite">Connecting to the demo…</p>
            <Control as="progress" id="demo-progress-bar" aria-label="Demo download progress"></Control>
            <div class="demo-progress-detail"><span id="demo-progress-bytes">Waiting for the download</span><span>Private conversations stay private</span></div>
            <Control as="button" variant="outline" selection="primary" id="cancel-demo" class="" type="button">Cancel</Control>
          </section>

        <section id="progress-view" class="progress-view" hidden aria-labelledby="progress-heading">
          <div class="progress-heading-row">
            <div>
              <p id="progress-phase" class="map-key">Reading archive</p>
              <h2 id="progress-heading" class="font-display">Building your memory map</h2>
            </div>
            <Control as="button" variant="outline" selection="primary" id="cancel-analysis" class="" type="button">Cancel</Control>
          </div>
          <div class="progress-route" aria-hidden="true">
            <span class="progress-stop is-active"></span>
            <span class="progress-line"><i id="progress-line-fill"></i></span>
            <span class="progress-stop"></span>
          </div>
          <div
            id="progress-status"
            class="progress-status"
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            Inspecting ZIP entries…
          </div>
          <div class="timing-overview" aria-label="Analysis timing">
            <div>
              <span>Total elapsed</span>
              <strong id="progress-elapsed">Under 1 sec</strong>
            </div>
            <div>
              <span>Estimated remaining</span>
              <strong id="progress-remaining">Estimating…</strong>
            </div>
            <div>
              <span>Compute route</span>
              <strong id="progress-runtime">Selecting…</strong>
            </div>
          </div>
          <div id="graph-formation-progress-slot" class="graph-formation-slot">
            <section
              id="graph-formation"
              class="graph-formation"
              aria-labelledby="graph-formation-heading"
            >
              <header>
                <div>
                  <p class="map-key">Ingestion sketch · deterministic routes</p>
                  <h2 id="graph-formation-heading" class="font-display">Every conversation becomes a stop.</h2>
                </div>
                <output id="graph-formation-count">Waiting for the first conversation…</output>
              </header>
              <canvas
                id="graph-formation-canvas"
                width="1000"
                height="420"
                aria-hidden="true"
              ></canvas>
              <footer>
                <div>
                  <span>Latest stop</span>
                  <strong id="graph-formation-latest">Opening the archive</strong>
                </div>
                <div>
                  <span>Active routes</span>
                  <strong id="graph-formation-routes">0 of 11</strong>
                </div>
                <p>
                  This preliminary sketch uses disclosed question-domain rules. The embedding
                  model replaces it with the final semantic topology.
                </p>
              </footer>
            </section>
          </div>
          <ol id="progress-stage-list" class="timing-stages" aria-label="Analysis stages">
            <li data-timing-stage="discover">
              <i></i><span>Open archive</span><time>Now</time>
            </li>
            <li data-timing-stage="parse">
              <i></i><span>Read conversations</span><time>Waiting</time>
            </li>
            <li data-timing-stage="statistics">
              <i></i><span>Initial insights</span><time>Waiting</time>
            </li>
            <li data-timing-stage="model">
              <i></i><span>Prepare model</span><time>Waiting</time>
            </li>
            <li data-timing-stage="embed">
              <i></i><span>Map semantic memory</span><time>Waiting</time>
            </li>
            <li data-timing-stage="cluster">
              <i></i><span>Assemble report</span><time>Waiting</time>
            </li>
          </ol>
          <p class="progress-note">
            Statistics appear before embeddings finish. The first semantic run downloads and
            caches the selected model in your browser.
          </p>
        </section>

        <section id="error-view" class="error-view" hidden aria-labelledby="error-heading">
          <p class="map-key">Route interrupted</p>
          <h2 id="error-heading" class="font-display">This archive could not be mapped.</h2>
          <p id="error-message"></p>
          <Control as="button" variant="outline" selection="primary" id="retry-demo" class="" type="button" hidden>Retry demo</Control>
          <Control as="button" variant="brand" id="error-reset" class="" type="button">Choose another ZIP</Control>
        </section>

        <section id="report-view" class="report-view" hidden>
          <header class="report-header">
            <div>
              <p class="map-key">Mapped memory</p>
              <h2 class="font-display">Your conversation history, connected.</h2>
              <p id="report-meta" class="report-meta"></p>
            </div>
            <div class="report-actions">
              <Control as="button" variant="outline" selection="primary" id="open-story" class="" type="button">
                Play your story
              </Control>
              <Control as="button" variant="outline" selection="primary" id="save-memory" class="" type="button">
                Keep on this device
              </Control>
              <Control as="button" variant="outline" selection="primary" id="forget-memory" class=" danger" type="button" hidden>
                Forget
              </Control>
              <Control as="button" variant="outline" selection="primary" id="reset-report" class="" type="button">New archive</Control>
            </div>
          </header>

          <aside id="demo-notice" class="demo-notice" hidden>
            <span class="demo-badge">Live demo · real aggregates</span>
            <p>Activity and question routes from a real history. Conversation text, titles, personal facts and source links have been removed.</p>
            <small>Routes connect where question domains appear in the same conversations. This is co-occurrence, not semantic similarity.</small>
          </aside>

          <Control as="details" id="analysis-details" class="analysis-details" open>
            <Control as="summary">
              <span>
                <strong>Analysis details</strong>
                <small id="analysis-details-summary">
                  Semantic work is running · balanced evidence
                </small>
              </span>
              <b>Timing, model, and confidence</b>
            </Control>
            <div class="analysis-details-body">
              <section
                id="analysis-timing-board"
                class="analysis-timing-board"
                aria-labelledby="analysis-timing-heading"
                hidden
              >
                <div class="analysis-timing-heading">
                  <div>
                    <p class="map-key">Live execution route</p>
                    <h2 id="analysis-timing-heading" class="font-display">How long your map took</h2>
                  </div>
                  <p id="report-timing-status" role="status" aria-live="polite">
                    Initial insights are ready. Semantic analysis is continuing.
                  </p>
                </div>
                <dl class="analysis-timing-metrics">
                  <div>
                    <dt>Initial insight</dt>
                    <dd id="report-timing-initial">—</dd>
                  </div>
                  <div class="timing-total">
                    <dt>End to end</dt>
                    <dd id="report-timing-total">Running…</dd>
                  </div>
                  <div>
                    <dt>Model preparation</dt>
                    <dd id="report-timing-model">Waiting</dd>
                  </div>
                  <div>
                    <dt>Semantic work</dt>
                    <dd id="report-timing-semantic">Waiting</dd>
                  </div>
                  <div>
                    <dt>Compute route</dt>
                    <dd id="report-timing-runtime">Selecting…</dd>
                  </div>
                  <div>
                    <dt>Candidate coverage</dt>
                    <dd id="report-timing-coverage">Forming…</dd>
                  </div>
                </dl>
                <ol id="report-stage-list" class="timing-stages timing-stages-report" aria-label="Analysis stage timings">
                  <li data-timing-stage="discover">
                    <i></i><span>Open archive</span><time>Waiting</time>
                  </li>
                  <li data-timing-stage="parse">
                    <i></i><span>Read conversations</span><time>Waiting</time>
                  </li>
                  <li data-timing-stage="statistics">
                    <i></i><span>Initial insights</span><time>Waiting</time>
                  </li>
                  <li data-timing-stage="model">
                    <i></i><span>Prepare model</span><time>Waiting</time>
                  </li>
                  <li data-timing-stage="embed">
                    <i></i><span>Map semantic memory</span><time>Waiting</time>
                  </li>
                  <li data-timing-stage="cluster">
                    <i></i><span>Assemble report</span><time>Waiting</time>
                  </li>
                </ol>
              </section>

              <section id="local-trace-section" class="local-trace-section" hidden aria-labelledby="local-trace-heading">
                <div>
                  <p class="map-key">Private to this tab</p>
                  <h3 id="local-trace-heading">Completion trace</h3>
                  <p id="local-trace-summary" class="method-note">
                    Archive contents and derived text stay out of this trace.
                  </p>
                </div>
                <Control as="button" variant="outline" selection="primary" id="export-local-trace" class="" type="button">
                  Export local trace
                </Control>
              </section>

              <section class="analysis-lens" aria-labelledby="analysis-lens-heading">
                <div>
                  <p class="map-key">Filter inferred evidence</p>
                  <h2 id="analysis-lens-heading" class="font-display">Analysis lens</h2>
                  <p id="model-profile-note"></p>
                </div>
                <div class="report-confidence">
                  <div id="report-confidence-presets" class="confidence-presets" aria-label="Report confidence presets">
                    <Control as="button" variant="outline" selection="primary" type="button" data-confidence="45">Exploratory</Control>
                    <Control as="button" variant="outline" selection="primary" type="button" data-confidence="65" aria-pressed="true">Balanced</Control>
                    <Control as="button" variant="outline" selection="primary" type="button" data-confidence="82">Conservative</Control>
                  </div>
                  <label for="report-confidence-input">
                    <span>Visible evidence threshold</span>
                    <Control as="input" id="report-confidence-input" type="range" min="35" max="90" value="65" />
                    <output id="report-confidence-output" for="report-confidence-input">65%</output>
                  </label>
                  <small id="confidence-impact">Semantic candidates will be filtered without re-reading your ZIP.</small>
                </div>
              </section>
            </div>
          </Control>

          <section id="overview" class="platform-section overview-section" aria-labelledby="overview-heading">
            <div class="section-heading">
              <div>
                <p class="map-key">Network scale</p>
                <h2 id="overview-heading" class="font-display">Overview</h2>
              </div>
              <p id="sampling-note" class="method-note"></p>
            </div>
            <dl id="overview-stats" class="baseline-stats"></dl>
          </section>

          <section
            id="visual-atlas"
            class="platform-section visual-atlas-section"
            aria-labelledby="visual-atlas-heading"
          >
            <div class="section-heading atlas-heading">
              <div>
                <p class="map-key">Seven ways to see the archive</p>
                <h2 id="visual-atlas-heading" class="font-display">Visual atlas</h2>
              </div>
              <div class="atlas-period-control">
                <label for="atlas-period">View period</label>
                <Control as="select" id="atlas-period">
                  <option value="3">Recent 3 months</option>
                  <option value="6">Recent 6 months</option>
                  <option value="12" selected>Recent 12 months</option>
                  <option value="24">Recent 24 months</option>
                  <option value="all">All history</option>
                </Control>
                <small id="atlas-period-note">
                  Applied to chronological charts, query tone, and language signals. What changed
                  remains an all-history comparison.
                </small>
              </div>
            </div>

            <div class="atlas-key" aria-label="Visual atlas legend">
              <span><i class="atlas-key-deterministic"></i>Full parsed export</span>
              <span><i class="atlas-key-semantic"></i>Embedding-backed sample</span>
              <span><i class="atlas-key-action"></i>Open a mark to inspect sources</span>
            </div>

            <Control as="button" variant="outline" selection="primary" id="atlas-highlight" class="atlas-highlight grid h-auto w-full grid-cols-1 gap-4 whitespace-normal p-5 text-left sm:grid-cols-2 xl:grid-cols-[0.35fr_1fr_0.75fr_auto]" type="button" hidden>
              <span>Start here · strongest signal in this period</span>
              <strong id="atlas-highlight-title"></strong>
              <small id="atlas-highlight-detail"></small>
              <b>Open source conversations →</b>
            </Control>

            <div class="visual-atlas-grid">
              <ChartPanel class="atlas-figure activity-calendar-figure">
                <figcaption class={chartHeaderStyles}>
                  <span><b>01</b><strong class={chartTitleStyles}>Activity calendar</strong></span>
                  <small id="activity-window-label">Conversation starts · selected period</small>
                </figcaption>
                <div
                  id="activity-calendar"
                  class="activity-calendar"
                  aria-label="Recent daily conversation activity"
                ></div>
                <Control as="details" class="chart-data">
                  <Control as="summary">Read activity data</Control>
                  <div id="activity-calendar-data" class="chart-data-list"></div>
                </Control>
              </ChartPanel>

              <ChartPanel class="atlas-figure question-mix-figure">
                <figcaption class={chartHeaderStyles}>
                  <span><b>02</b><strong class={chartTitleStyles}>Question mix over time</strong></span>
                  <small id="question-window-label">Top five overlapping query routes</small>
                </figcaption>
                <div id="question-mix-legend" class="chart-legend"></div>
                <div
                  id="question-mix-chart"
                  class="atlas-plot question-mix-chart"
                  aria-label="Question lens activity over the recent twelve months"
                ></div>
                <Control as="details" class="chart-data">
                  <Control as="summary">Read question-mix data</Control>
                  <div id="question-mix-data" class="chart-data-list"></div>
                </Control>
              </ChartPanel>

              <ChartPanel class="atlas-figure language-matrix-figure">
                <figcaption class={chartHeaderStyles}>
                  <span><b>03</b><strong class={chartTitleStyles}>Language signal matrix</strong></span>
                  <small id="language-window-label">Dominant vocabulary cue per query</small>
                </figcaption>
                <div
                  id="language-matrix"
                  class="language-matrix"
                  aria-label="Query wording signals by month"
                ></div>
                <p class="atlas-caveat">
                  Wording signals, not feelings, personality, or diagnosis.
                </p>
                <Control as="details" class="chart-data">
                  <Control as="summary">Read language-signal data</Control>
                  <div id="language-matrix-data" class="chart-data-list"></div>
                </Control>
              </ChartPanel>

              <ChartPanel class="atlas-figure repeat-landscape-figure">
                <figcaption class={chartHeaderStyles}>
                  <span><b>04</b><strong class={chartTitleStyles}>Repeat landscape</strong></span>
                  <small class={chartDescriptionStyles}>Frequency × time span · exact and semantic groups</small>
                </figcaption>
                <div
                  id="repeat-landscape"
