{
  "name": "@saas-maker/templates",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "description": "Content-driven landing page templates (Gallery, Workbench) and the base layout.",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./*.astro": "./src/*.astro",
    "./schema": "./src/schema.ts",
    "./page": "./src/page.ts",
    "./*": "./src/*.tsx",
    "./gallery.css": "./src/gallery.css",
    "./workbench.css": "./src/workbench.css",
    "./console.css": "./src/console.css"
  },
  "dependencies": {
    "lucide-react": "1.48.0"
  },
  "peerDependencies": {
    "@saas-maker/ui": "0.x",
    "@saas-maker/motion": "0.x",
    "astro": ">=7",
    "react": ">=19"
  },
  "devDependencies": {
    "@saas-maker/ui": "workspace:*",
    "@saas-maker/motion": "workspace:*",
    "astro": "7.3.5"
  },
  "sideEffects": [
    "*.css"
  ]
}
