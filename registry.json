{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "fleet-ui",
  "homepage": "https://github.com/",
  "items": [
    {
      "name": "theme",
      "type": "registry:file",
      "title": "Fleet UI theme",
      "description": "Tokens, five presets (base, paper, ink, hearth, signal), fonts and base styles.",
      "dependencies": [
        "tw-animate-css",
        "@fontsource-variable/geist",
        "@fontsource-variable/geist-mono",
        "@fontsource-variable/newsreader",
        "@fontsource/instrument-serif",
        "@fontsource-variable/fraunces",
        "@fontsource-variable/instrument-sans"
      ],
      "files": [
        {
          "path": "src/styles/globals.css",
          "type": "registry:file",
          "target": "src/styles/fleet-ui.css"
        }
      ]
    },
    {
      "name": "layout",
      "type": "registry:block",
      "title": "layout",
      "description": "Container, Section, SectionHeader and FactRow.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "src/components/blocks/layout.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "site-header",
      "type": "registry:block",
      "title": "site-header",
      "description": "Sticky bar or floating header with a zero-JS phone menu.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "src/components/blocks/site-header.tsx",
          "type": "registry:component"
        },
        {
          "path": "src/components/blocks/mobile-nav.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "hero",
      "type": "registry:block",
