    "--surface": "oklch(0.155 0.014 280)",
    "--card": "oklch(0.165 0.014 280)",
    "--sidebar": "oklch(0.145 0.013 280)",
    "--chart-2": "oklch(0.78 0.14 200)",
  }}
>
  <Page />
</Base>
