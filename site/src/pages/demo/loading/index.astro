---
import "@saas-maker/ui/styles.css";
import Base from "@saas-maker/templates/Base.astro";
import LoadingDemo from "@/demos/loading";
---
<Base title="Loading states — SaaS Maker UI" description="Calm, content-shaped loading states, cached resources, empty states and retry." theme="base" motion={false}>
  <main class="loading-page">
    <nav><a href="/">saas maker ui</a><a href="/docs/loading/">loading guide ↗</a></nav>
    <header><p class="loading-note">components / loading states</p><h1>keep the shape.<br />let the data arrive.</h1><p>Quiet placeholders and clear next steps, from first request to revisit.</p></header>
    <LoadingDemo client:load />
  </main>
</Base>
<style is:global>
  .loading-page { max-width: 1120px; margin: auto; padding: 32px clamp(20px, 4vw, 48px) 80px; }
  .loading-page nav { display: flex; justify-content: space-between; gap: 16px; font-size: 14px; }
  .loading-page header { padding: 64px 0 48px; }
  .loading-page h1 { font: 500 clamp(36px, 5vw, 64px)/1.05 var(--font-display); letter-spacing: -.04em; margin: 12px 0 20px; }
  .loading-page h2 { font-size: 22px; font-weight: 500; letter-spacing: -.025em; margin-bottom: 12px; }
  .loading-page h3 { font-size: 14px; font-weight: 500; margin-bottom: 20px; }
  .loading-page p { color: var(--muted-foreground); line-height: 1.65; }
  .loading-page .loading-note { font-size: 13px; }
  .loading-playground { border: 1px solid var(--border); border-radius: 16px; padding: clamp(20px, 4vw, 32px); margin-bottom: 64px; }
  .loading-controls { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 12px; }
  .loading-demo-stage { min-height: 190px; display: grid; align-items: center; margin: 24px 0; }
  .loading-demo-result { width: 100%; }
  .loading-demo-result [data-slot="card-content"] p { line-height: 1rem; }
  .loading-away { text-align: center; }
  .loading-examples { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  .loading-example { min-width: 0; border-top: 1px solid var(--border); padding: 24px 0; }
  .loading-person { display: flex; align-items: center; gap: 20px; }
  .loading-person > :last-child { flex: 1; }
  .loading-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 600px) { .loading-examples { grid-template-columns: 1fr; gap: 8px; } .loading-page header { padding: 48px 0 32px; } }
</style>
