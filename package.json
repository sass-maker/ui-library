{
  "name": "ui-library",
  "version": "0.1.32",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @saas-maker/ui-site dev",
    "build": "pnpm --filter @saas-maker/ui-site build && pnpm registry:build",
    "check": "pnpm test && pnpm typecheck && pnpm storybook:check && pnpm check:explorer && pnpm check:architecture && pnpm registry:check && pnpm --filter @saas-maker/ui-site check",
    "check:browser": "node site/scripts/browser-check.mjs",
    "registry:build": "shadcn build --output site/dist/r",
    "typecheck": "tsc -p tsconfig.json",
    "tokens:build": "node packages/tokens/build.mjs",
    "footer:build": "pnpm --filter @saas-maker/ui footer:build",
    "test": "pnpm --filter @saas-maker/ui test",
    "landings:dev": "pnpm --dir archives/ios-landings run dev",
    "landings:build": "pnpm --dir archives/ios-landings run build",
    "landings:check": "pnpm --dir archives/ios-landings run check",
    "landings:check:one": "pnpm --dir archives/ios-landings run check:one",
    "landings:deploy": "pnpm --dir archives/ios-landings run deploy",
    "landings:deploy:daddyrad": "pnpm --dir archives/ios-landings run deploy:daddyrad",
    "storybook": "pnpm --filter @saas-maker/ui-explorer dev",
    "storybook:build": "pnpm --filter @saas-maker/ui-explorer build",
    "storybook:check": "pnpm --filter @saas-maker/ui-explorer check",
    "check:explorer": "node explorer/scripts/check-explorer.mjs",
    "check:browser:explorer": "node site/scripts/browser-check.mjs --explorer",
    "registry:sync": "node scripts/sync-registry.mjs",
    "registry:check": "node scripts/sync-registry.mjs --check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:browser": "playwright test",
    "test:visual": "playwright test --project=visual"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "typescript": "5.9.3",
    "@playwright/test": "1.64.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@vitest/spy@3.2.7>tinyspy": "4.0.4",
      "vite@7.3.7>rollup": "4.63.1",
      "happy-dom>@types/node": "25.9.5"
    }
  }
}
