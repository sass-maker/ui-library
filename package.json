{
  "name": "ui-library",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @saas-maker/ui-site dev",
    "build": "pnpm --filter @saas-maker/ui-site build && pnpm registry:build",
    "check": "pnpm typecheck && pnpm --filter @saas-maker/ui-site check",
    "registry:build": "shadcn build --output site/dist/r",
    "typecheck": "tsc -p tsconfig.json",
    "tokens:build": "node packages/tokens/build.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
